---
---
<nav id="navbar">
  <div class="container">
    <div class="nav-inner">
      <a href="#inicio" class="nav-logo-img">
        <img src="/images/logo-transparent.png" alt="Red Mangle" class="logo-img" />
      </a>
      <ul class="nav-links">
        <li><a href="#inicio" data-i18n="nav.inicio">Inicio</a></li>
        <li><a href="#nosotros" data-i18n="nav.nosotros">Nosotros</a></li>
        <li><a href="#soluciones" data-i18n="nav.soluciones">Soluciones</a></li>
        <li><a href="#proyectos" data-i18n="nav.proyectos">Proyectos</a></li>
        <li><a href="#contacto" class="nav-cta" data-i18n="nav.contacto">Contacto</a></li>
        <li>
          <button class="lang-toggle" id="langToggle" aria-label="Switch language">
            <span class="lang-option active" data-lang="es">🇲🇽 ES</span>
            <span class="lang-divider">|</span>
            <span class="lang-option" data-lang="en">🇺🇸 EN</span>
          </button>
        </li>
      </ul>
      <div class="nav-right-mobile">
        <button class="lang-toggle lang-toggle-mobile" id="langToggleMobile" aria-label="Switch language">
          <span class="lang-option active" data-lang="es">ES</span>
          <span class="lang-divider">/</span>
          <span class="lang-option" data-lang="en">EN</span>
        </button>
        <button class="hamburger" id="hamburger" aria-label="Menú">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
    <nav class="mobile-menu" id="mobileMenu">
      <a href="#inicio" class="mobile-link" data-i18n="nav.inicio">Inicio</a>
      <a href="#nosotros" class="mobile-link" data-i18n="nav.nosotros">Nosotros</a>
      <a href="#soluciones" class="mobile-link" data-i18n="nav.soluciones">Soluciones</a>
      <a href="#proyectos" class="mobile-link" data-i18n="nav.proyectos">Proyectos</a>
      <a href="#contacto" class="mobile-link" data-i18n="nav.contacto">Contacto</a>
    </nav>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar!.classList.toggle('scrolled', window.scrollY > 60);
  }, { passive: true });

  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  hamburger!.addEventListener('click', () => {
    hamburger!.classList.toggle('open');
    mobileMenu!.classList.toggle('open');
  });
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      hamburger!.classList.remove('open');
      mobileMenu!.classList.remove('open');
    });
  });
</script>
