---
---
<nav id="navbar">
  <div class="container">
    <div class="nav-inner">
      <a href="#inicio" class="nav-logo">
        <span class="red">RED</span>MANGLE
        <span class="sub">Construfibra &amp; Eventos</span>
      </a>
      <ul class="nav-links">
        <li><a href="#inicio">Inicio</a></li>
        <li><a href="#nosotros">Nosotros</a></li>
        <li><a href="#soluciones">Soluciones</a></li>
        <li><a href="#proyectos">Proyectos</a></li>
        <li><a href="#contacto" class="nav-cta">Contacto</a></li>
      </ul>
      <button class="hamburger" id="hamburger" aria-label="Menú">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav class="mobile-menu" id="mobileMenu">
      <a href="#inicio" class="mobile-link">Inicio</a>
      <a href="#nosotros" class="mobile-link">Nosotros</a>
      <a href="#soluciones" class="mobile-link">Soluciones</a>
      <a href="#proyectos" class="mobile-link">Proyectos</a>
      <a href="#contacto" class="mobile-link">Contacto</a>
    </nav>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar!.classList.toggle('scrolled', window.scrollY > 60);
  }, { passive: true });

  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  hamburger!.addEventListener('click', () => {
    hamburger!.classList.toggle('open');
    mobileMenu!.classList.toggle('open');
  });
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      hamburger!.classList.remove('open');
      mobileMenu!.classList.remove('open');
    });
  });
</script>
