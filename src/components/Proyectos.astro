---
---
<section id="proyectos">
  <div class="container">
    <div class="section-header fade-in">
      <div>
        <span class="label"><span class="label-num">03 —</span><span data-i18n="proyectos.label">Portafolio</span></span>
        <h2 class="section-title" data-i18n-html="proyectos.title">Proyectos <span>Destacados</span></h2>
      </div>
      <p data-i18n="proyectos.desc">Más de 50 proyectos entregados en la Riviera Maya, el Caribe y toda la República Mexicana.</p>
    </div>
    <div class="filter-tabs fade-in">
      <button class="filter-btn active" data-filter="all" data-i18n="proyectos.all">Todos</button>
      <button class="filter-btn" data-filter="hotel" data-i18n="proyectos.hotel">Hoteles</button>
      <button class="filter-btn" data-filter="condo" data-i18n="proyectos.condo">Condominios</button>
      <button class="filter-btn" data-filter="infra" data-i18n="proyectos.infra">Infraestructura</button>
    </div>
    <div class="projects-grid" id="projectsGrid">

      <div class="project-card large fade-in" data-category="hotel">
        <img class="project-bg" src="/images/projects/royalton.webp" alt="Royalton Riviera Cancún" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.hotel_rm">Hotel · Riviera Maya</div>
          <div class="project-name">Royalton Riviera Cancún</div>
          <div class="project-meta">
            <span>2022–2023</span><span>Pergolados · Plafones · Celosías</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" data-category="hotel">
        <img class="project-bg" src="/images/projects/four-seasons.webp" alt="Four Seasons East Cape" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.hotel_lc">Hotel · Los Cabos</div>
          <div class="project-name">Four Seasons East Cape</div>
          <div class="project-meta">
            <span>2021</span><span>Decorativos · Mamparas</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.1s" data-category="hotel">
        <img class="project-bg" src="/images/projects/secrets-moxche.webp" alt="Secrets Moxche" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.hotel_pdc">Hotel · Playa del Carmen</div>
          <div class="project-name">Secrets Moxche</div>
          <div class="project-meta">
            <span>2022</span><span>Celosías · Macetas</span>
          </div>
        </div>
      </div>

      <div class="project-card large fade-in" data-category="infra">
        <img class="project-bg" src="/images/projects/tren-maya.webp" alt="Tren Maya SEDENA" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.infra">Infraestructura · Nacional</div>
          <div class="project-name">Tren Maya — SEDENA</div>
          <div class="project-meta">
            <span>2023–2024</span><span>Plafones · Decorativos · Mamparas</span><span>Múltiples estaciones</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.05s" data-category="hotel">
        <img class="project-bg" src="/images/projects/hotel-ava.webp" alt="Hotel AVA Cancún" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.hotel_can">Hotel · Cancún</div>
          <div class="project-name">Hotel AVA Cancún</div>
          <div class="project-meta">
            <span>2023</span><span>Pergolados · Morillos</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.10s" data-category="hotel">
        <img class="project-bg" src="/images/projects/xcaret.webp" alt="Xcaret Arte" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.park_qr">Parque · Quintana Roo</div>
          <div class="project-name">Xcaret Arte</div>
          <div class="project-meta">
            <span>2020–2021</span><span>Decorativos · Celosías</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" data-category="hotel">
        <img class="project-bg" src="/images/projects/hyatt.webp" alt="Hyatt Ziva Cancún" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.hotel_can">Hotel · Cancún</div>
          <div class="project-name">Hyatt Ziva Cancún</div>
          <div class="project-meta">
            <span>2019</span><span>Pergolados · Mamparas</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.05s" data-category="condo">
        <img class="project-bg" src="/images/projects/aloft.webp" alt="Aloft Cancún" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.res_can">Residencial · Cancún</div>
          <div class="project-name">Aloft Cancún</div>
          <div class="project-meta">
            <span>2021</span><span>Plafones · Decorativos</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.10s" data-category="hotel">
        <img class="project-bg" src="/images/projects/hard-rock.webp" alt="Hard Rock Riviera Maya" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.hotel_rm">Hotel · Riviera Maya</div>
          <div class="project-name">Hard Rock Riviera Maya</div>
          <div class="project-meta">
            <span>2018–2019</span><span>Celosías · Morillos</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" data-category="hotel">
        <img class="project-bg" src="/images/projects/westin.webp" alt="Westin Cancún" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.hotel_can">Hotel · Cancún</div>
          <div class="project-name">Westin Cancún</div>
          <div class="project-meta">
            <span>2020</span><span>Pergolados · Macetas</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.05s" data-category="condo">
        <img class="project-bg" src="/images/projects/paradisus.webp" alt="Paradisus Playa del Carmen" loading="lazy" />
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category" data-i18n="proj.cat.res_rm">Residencial · Riviera Maya</div>
          <div class="project-name">Paradisus Playa del Carmen</div>
          <div class="project-meta">
