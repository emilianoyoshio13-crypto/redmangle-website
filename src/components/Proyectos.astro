---
---
<section id="proyectos">
  <div class="container">
    <div class="section-header fade-in">
      <div>
        <span class="label">Portafolio</span>
        <h2 class="section-title">Proyectos <span>Destacados</span></h2>
      </div>
      <p>Más de 50 proyectos entregados en la Riviera Maya, el Caribe y toda la República Mexicana.</p>
    </div>
    <div class="filter-tabs fade-in">
      <button class="filter-btn active" data-filter="all">Todos</button>
      <button class="filter-btn" data-filter="hotel">Hoteles</button>
      <button class="filter-btn" data-filter="condo">Condominios</button>
      <button class="filter-btn" data-filter="infra">Infraestructura</button>
    </div>
    <div class="projects-grid" id="projectsGrid">

      <div class="project-card large fade-in" data-category="hotel">
        <div class="project-bg proj-1 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Hotel · Riviera Maya</div>
          <div class="project-name">Royalton Riviera Cancún</div>
          <div class="project-meta">
            <span>2022–2023</span><span>Pergolados · Plafones · Celosías</span><span class="project-value">$3.9M USD</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" data-category="hotel">
        <div class="project-bg proj-2 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Hotel · Los Cabos</div>
          <div class="project-name">Four Seasons East Cape</div>
          <div class="project-meta">
            <span>2021</span><span>Decorativos · Mamparas</span><span class="project-value">$2.4M USD</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.1s" data-category="hotel">
        <div class="project-bg proj-3 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Hotel · Playa del Carmen</div>
          <div class="project-name">Secrets Moxche</div>
          <div class="project-meta">
            <span>2022</span><span>Celosías · Macetas</span><span class="project-value">$1.8M USD</span>
          </div>
        </div>
      </div>

      <div class="project-card large fade-in" data-category="infra">
        <div class="project-bg proj-4 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Infraestructura · Nacional</div>
          <div class="project-name">Tren Maya — SEDENA</div>
          <div class="project-meta">
            <span>2023–2024</span><span>Plafones · Decorativos · Mamparas</span><span>Múltiples estaciones</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.05s" data-category="hotel">
        <div class="project-bg proj-5 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Hotel · Cancún</div>
          <div class="project-name">Hotel AVA Cancún</div>
          <div class="project-meta">
            <span>2023</span><span>Pergolados · Morillos</span><span class="project-value">$2.0M USD</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.10s" data-category="hotel">
        <div class="project-bg proj-6 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Parque · Quintana Roo</div>
          <div class="project-name">Xcaret Arte</div>
          <div class="project-meta">
            <span>2020–2021</span><span>Decorativos · Celosías</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" data-category="hotel">
        <div class="project-bg proj-7 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Hotel · Cancún</div>
          <div class="project-name">Hyatt Ziva Cancún</div>
          <div class="project-meta">
            <span>2019</span><span>Pergolados · Mamparas</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.05s" data-category="condo">
        <div class="project-bg proj-8 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Residencial · Cancún</div>
          <div class="project-name">Aloft Cancún</div>
          <div class="project-meta">
            <span>2021</span><span>Plafones · Decorativos</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.10s" data-category="hotel">
        <div class="project-bg proj-9 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Hotel · Riviera Maya</div>
          <div class="project-name">Hard Rock Riviera Maya</div>
          <div class="project-meta">
            <span>2018–2019</span><span>Celosías · Morillos</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" data-category="hotel">
        <div class="project-bg proj-10 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Hotel · Cancún</div>
          <div class="project-name">Westin Cancún</div>
          <div class="project-meta">
            <span>2020</span><span>Pergolados · Macetas</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.05s" data-category="condo">
        <div class="project-bg proj-11 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Residencial · Riviera Maya</div>
          <div class="project-name">Paradisus Playa del Carmen</div>
          <div class="project-meta">
            <span>2017</span><span>Celosías · Decorativos</span>
          </div>
        </div>
      </div>

      <div class="project-card fade-in" style="transition-delay:0.10s" data-category="hotel">
        <div class="project-bg proj-12 proj-pattern"></div>
        <div class="project-overlay"></div>
        <div class="project-info">
          <div class="project-category">Hotel · Cancún</div>
          <div class="project-name">Margaritaville Beach Resort</div>
          <div class="project-meta">
            <span>2022</span><span>Morillos · Macetas · Plafones</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = (btn as HTMLElement).dataset.filter!;
      projectCards.forEach(card => {
        const match = filter === 'all' || (card as HTMLElement).dataset.category === filter;
        (card as HTMLElement).style.display = match ? '' : 'none';
      });
    });
  });
</script>
