---
const clients = [
  'Royalton', 'Four Seasons', 'Xcaret', 'Hyatt', 'Westin',
  'Hard Rock', 'Margaritaville', 'Paradisus', 'Dreams Resorts',
  'SEDENA', 'Planet Hollywood', 'Secrets Resorts', 'Aloft Hotels',
];
---
<section id="clientes">
  <div class="container">
    <div class="clients-header fade-in">
      <span class="label">Confían en Nosotros</span>
      <h2 class="section-title" style="color:var(--white)">Nuestros <span>Clientes</span></h2>
      <p>Cadenas hoteleras y organismos de clase mundial en México y el Caribe</p>
    </div>
  </div>
  <div class="clients-track-wrap">
    <div class="clients-track">
      {/* Duplicated for seamless loop */}
      {[...clients, ...clients].map(name => (
        <div class="client-name">
          <span class="client-dot"></span>{name}
        </div>
      ))}
    </div>
  </div>
</section>
