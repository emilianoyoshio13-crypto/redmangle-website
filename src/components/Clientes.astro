---
const clients = [
  { name: 'Royalton',         domain: 'royaltonresorts.com' },
  { name: 'Four Seasons',     domain: 'fourseasons.com' },
  { name: 'Xcaret',           domain: 'xcaret.com' },
  { name: 'Hyatt',            domain: 'hyatt.com' },
  { name: 'Westin',           domain: 'westin.com' },
  { name: 'Hard Rock',        domain: 'hardrock.com' },
  { name: 'Margaritaville',   domain: 'margaritavilleresorts.com' },
  { name: 'Paradisus',        domain: 'melia.com' },
  { name: 'Dreams Resorts',   domain: 'dreamsresorts.com' },
  { name: 'SEDENA',           domain: 'gob.mx' },
  { name: 'Planet Hollywood', domain: 'planethollywood.com' },
  { name: 'Secrets Resorts',  domain: 'secretsresorts.com' },
  { name: 'Aloft Hotels',     domain: 'alofthotels.com' },
];
---
<section id="clientes">
  <div class="container">
    <div class="clients-header fade-in">
      <span class="label">Confían en Nosotros</span>
      <h2 class="section-title" style="color:var(--white)">Nuestros <span>Clientes</span></h2>
      <p>Cadenas hoteleras y organismos de clase mundial en México y el Caribe</p>
    </div>
  </div>
  <div class="clients-track-wrap">
    <div class="clients-track">
      {[...clients, ...clients].map(c => (
        <div class="client-item">
          <img
            src={`https://logo.clearbit.com/${c.domain}`}
            alt={c.name}
            class="client-logo"
            loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
          <span class="client-name-fallback">
            <span class="client-dot"></span>{c.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
