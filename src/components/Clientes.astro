---
const clients = [
  { name: 'Royalton',         local: '/images/clients/royalton.png' },
  { name: 'Four Seasons',     local: '/images/clients/four-seasons.png' },
  { name: 'Xcaret',           local: '/images/clients/xcaret.png' },
  { name: 'Hyatt',            local: '/images/clients/hyatt.png' },
  { name: 'Westin',           local: '/images/clients/westin.png' },
  { name: 'Hard Rock',        local: '/images/clients/hard-rock.png' },
  { name: 'Margaritaville',   local: '/images/clients/margaritaville.svg' },
  { name: 'Paradisus',        local: '/images/clients/paradisus.png' },
  { name: 'Dreams Resorts',   local: '/images/clients/dreams.png' },
  { name: 'Senator',          local: '/images/clients/senator.png' },
  { name: 'SEDENA',           local: '/images/clients/sedena.svg' },
  { name: 'Planet Hollywood', local: '/images/clients/planet-hollywood.svg' },
  { name: 'Secrets Resorts',  local: '/images/clients/secrets.png' },
  { name: 'Aloft Hotels',     local: '/images/clients/aloft.svg' },
];
---
<section id="clientes">
  <div class="container">
    <div class="clients-header fade-in">
      <span class="label"><span class="label-num">04 —</span><span data-i18n="clientes.label">Confían en Nosotros</span></span>
      <h2 class="section-title" style="color:var(--white)" data-i18n-html="clientes.title">Nuestros <span>Clientes</span></h2>
      <p data-i18n="clientes.desc">Cadenas hoteleras y organismos de clase mundial en México y el Caribe</p>
    </div>
  </div>
  <div class="clients-track-wrap">
    <div class="clients-track">
      {[...clients, ...clients].map(c => (
        <div class="client-item">
          <img
            src={c.local}
            alt={c.name}
            class="client-logo"
            loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
          <span class="client-name-fallback">
            <span class="client-dot"></span>{c.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
