---
---
<section id="inicio">
  <!-- Slideshow background -->
  <div class="hero-slides" aria-hidden="true">
    <img class="hero-slide active" src="/images/hero/slideshow/slide-1.jpeg" alt="" fetchpriority="high" />
    <img class="hero-slide" src="/images/hero/slideshow/slide-2.jpeg" alt="" loading="lazy" />
    <img class="hero-slide" src="/images/hero/slideshow/slide-3.jpeg" alt="" loading="lazy" />
    <img class="hero-slide" src="/images/hero/slideshow/slide-4.jpeg" alt="" loading="lazy" />
    <img class="hero-slide" src="/images/hero/slideshow/slide-5.jpeg" alt="" loading="lazy" />
    <img class="hero-slide" src="/images/hero/slideshow/slide-6.jpeg" alt="" loading="lazy" />
    <img class="hero-slide" src="/images/hero/slideshow/slide-7.png"  alt="" loading="lazy" />
  </div>
  <!-- Dark overlay to keep text readable -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-top-fade"></div>
  <div class="hero-ring"></div>
  <div class="hero-content">
    <img src="/images/logo-transparent.png" alt="Red Mangle" class="hero-logo" />
    <p class="hero-sub">
      Construcción <span>·</span> Arquitectura <span>·</span> Decoración <span>·</span> Fibra de Vidrio
    </p>
    <div>
      <a href="#contacto" class="btn btn-primary">
        Iniciar Proyecto
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#proyectos" class="btn btn-outline">Ver Portafolio</a>
    </div>
  </div>
  <div class="hero-fade-bottom"></div>
  <div class="hero-scroll">
    <div class="hero-scroll-line"></div>
    <span>scroll</span>
  </div>
</section>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  // First image stays 7 s, all others stay 4 s
  const durations = [7000, 4000, 4000, 4000, 4000, 4000, 4000];
  let current = 0;

  function nextSlide() {
    slides[current].classList.remove('active');
    current = (current + 1) % slides.length;
    slides[current].classList.add('active');
    setTimeout(nextSlide, durations[current]);
  }

  setTimeout(nextSlide, durations[0]);
</script>
