const delays = ['0s','0.05s','0.10s','0.15s','0.20s','0.25s','0.30s'];
---

<section id="soluciones">
  <div class="container">
    <div class="section-header fade-in">
      <div>
        <span class="label"><span class="label-num">02 —</span><span data-i18n="soluciones.label">Nuestras Soluciones</span></span>
        <h2 class="section-title" data-i18n-html="soluciones.title">Lo que <span>hacemos</span></h2>
      </div>
      <p data-i18n="soluciones.desc">Soluciones integrales en fibra de vidrio y materiales compuestos para proyectos arquitectónicos de alto impacto.</p>
    </div>
    <div class="services-grid">
      {services.map((s, i) => (
        <div
          class="service-card fade-in"
          style={`transition-delay:${delays[i]}`}
          data-service={s.id}
          role="button"
          tabindex="0"
          aria-label={`Ver proyectos de ${s.title}`}
        >
          <div class="service-num">{s.num}</div>
          <div class="service-icon" set:html={s.icon} />
          <div class="service-title" data-i18n={`svc.${s.id}.title`}>{s.title}</div>
          <div class="service-desc" data-i18n={`svc.${s.id}.desc`}>{s.desc}</div>
          <div class="service-cta" data-i18n="soluciones.cta">Ver proyectos →</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Modal -->
<div class="svc-backdrop" id="svcBackdrop" aria-hidden="true">
  <div class="svc-modal" id="svcModal" role="dialog" aria-modal="true">
    <button class="svc-close" id="svcClose" aria-label="Cerrar">&times;</button>
    <div class="svc-modal-header">
      <span class="label" id="svcLabel"></span>
      <h3 class="svc-modal-title" id="svcTitle"></h3>
      <p class="svc-modal-desc" id="svcDesc"></p>
    </div>
    <div class="svc-projects-label" data-i18n="modal.projects_done">Proyectos realizados</div>
    <div class="svc-projects-grid" id="svcProjectsGrid"></div>
  </div>
</div>

<style is:global>
  /* ── Service card click affordance ── */
  .service-card {
    cursor: pointer;
  }
  .service-cta {
    margin-top: 16px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .service-card:hover .service-cta {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Backdrop ── */
  .svc-backdrop {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
  }
  .svc-backdrop.open {
    opacity: 1;
    pointer-events: all;
  }

  /* ── Modal box ── */
  .svc-modal {
    background: #fff;
    border-radius: 6px;
    width: 100%;
    max-width: 780px;
    max-height: 88vh;
    overflow-y: auto;
    padding: 48px;
    position: relative;
    transform: translateY(16px) scale(0.97);
    opacity: 0;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s ease;
  }
  .svc-backdrop.open .svc-modal {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  /* ── Close button ── */
  .svc-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 36px;
    height: 36px;
    border: 1px solid #ddd;
    border-radius: 2px;
    background: none;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--gray);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }
  .svc-close:hover {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
  }

  /* ── Modal header ── */
  .svc-modal-header {
    margin-bottom: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid #eee;
  }
  .svc-modal-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--black);
    margin-bottom: 10px;
  }
  .svc-modal-desc {
    font-size: 0.9rem;
    color: var(--gray);
    line-height: 1.65;
  }

  /* ── Projects grid inside modal ── */
  .svc-projects-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: 16px;
  }
  .svc-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .svc-proj-card {
    border-radius: 4px;
    overflow: hidden;
    background: var(--black);
    aspect-ratio: 4/3;
    position: relative;
  }
  .svc-proj-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 20px;
  }
  .svc-proj-placeholder svg {
    width: 28px;
    height: 28px;
    stroke: rgba(255,255,255,0.2);
    fill: none;
    stroke-width: 1.5;
  }
  .svc-proj-placeholder-text {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.2);
  }
  .svc-proj-info {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);
  }
  .svc-proj-name {
    font-size: 0.85rem;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 3px;
  }
  .svc-proj-meta {
    font-size: 0.65rem;
    color: rgba(255,255,255,0.5);
    display: flex;
    gap: 8px;
  }
  .svc-proj-meta span:first-child { color: rgba(200,16,46,0.85); }

  /* Placeholder gradient colours — cycling through 7 */
  .svc-proj-card:nth-child(1) { background: linear-gradient(135deg, #1a0a0d, #2d1018); }
  .svc-proj-card:nth-child(2) { background: linear-gradient(135deg, #0a0a1a, #101030); }
  .svc-proj-card:nth-child(3) { background: linear-gradient(135deg, #0d1a0a, #1a2d10); }
  .svc-proj-card:nth-child(4) { background: linear-gradient(135deg, #1a150a, #2d2210); }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .svc-modal { padding: 28px 20px; }
    .svc-projects-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const SVC_PROJECTS: Record<string, { name: string; location: string; year: string; img?: string }[]> = {
    pergolados: [
      { name: 'Royalton Riviera Cancún', location: 'Riviera Maya', year: '2022', img: '/images/services/pergolado-1.webp' },
      { name: 'Hotel AVA Cancún',        location: 'Cancún',       year: '2023', img: '/images/services/pergolado-2.webp' },
      { name: 'Westin Cancún',           location: 'Cancún',       year: '2020', img: '/images/services/pergolado-3.webp' },
      { name: 'Hyatt Ziva Cancún',       location: 'Cancún',       year: '2019', img: '/images/services/pergolado-4.webp' },
    ],
    celosias: [
      { name: 'Royalton Riviera Cancún',    location: 'Riviera Maya', year: '2022', img: '/images/services/celosia-1.webp' },
      { name: 'Xcaret Arte',                location: 'Quintana Roo', year: '2020', img: '/images/services/celosia-2.webp' },
      { name: 'Paradisus Playa del Carmen', location: 'Riviera Maya', year: '2017', img: '/images/services/celosia-3.webp' },
      { name: 'Hard Rock Riviera Maya',     location: 'Riviera Maya', year: '2018', img: '/images/services/celosia-4.webp' },
    ],
    plafones: [
      { name: 'Royalton Riviera Cancún', location: 'Riviera Maya',     year: '2022', img: '/images/services/plafon-1.webp' },
      { name: 'Tren Maya — SEDENA',      location: 'Nacional',         year: '2023', img: '/images/services/plafon-2.webp' },
      { name: 'Aloft Cancún',            location: 'Cancún',           year: '2021', img: '/images/services/plafon-3.webp' },
      { name: 'Secrets Moxche',          location: 'Playa del Carmen', year: '2022', img: '/images/services/plafon-4.webp' },
    ],
    decorativos: [
      { name: 'Four Seasons East Cape', location: 'Los Cabos',    year: '2021', img: '/images/services/decorativo-1.webp' },
      { name: 'Xcaret Arte',            location: 'Quintana Roo', year: '2020', img: '/images/services/decorativo-2.webp' },
      { name: 'Tren Maya — SEDENA',     location: 'Nacional',     year: '2023', img: '/images/services/decorativo-3.webp' },
      { name: 'Aloft Cancún',           location: 'Cancún',       year: '2021', img: '/images/services/decorativo-4.webp' },
    ],
    mamparas: [
      { name: 'Four Seasons East Cape', location: 'Los Cabos', year: '2021', img: '/images/services/mampara-1.webp' },
      { name: 'Hyatt Ziva Cancún',      location: 'Cancún',    year: '2019', img: '/images/services/mampara-2.webp' },
      { name: 'Tren Maya — SEDENA',     location: 'Nacional',  year: '2023', img: '/images/services/mampara-3.webp' },
    ],
    macetas: [
      { name: 'Secrets Moxche',        location: 'Playa del Carmen', year: '2022', img: '/images/services/maceta-1.webp' },
      { name: 'Westin Cancún',         location: 'Cancún',           year: '2020', img: '/images/services/maceta-2.webp' },
      { name: 'Margaritaville Resort', location: 'Cancún',           year: '2022', img: '/images/services/maceta-3.webp' },
    ],
    morillos: [
      { name: 'Hotel AVA Cancún',       location: 'Cancún',       year: '2023', img: '/images/services/morillo-1.webp' },
      { name: 'Hard Rock Riviera Maya', location: 'Riviera Maya', year: '2018', img: '/images/services/morillo-2.webp' },
      { name: 'Margaritaville Resort',  location: 'Cancún',       year: '2022', img: '/images/services/morillo-3.webp' },
    ],
  };

  const backdrop  = document.getElementById('svcBackdrop')!;
  const modal     = document.getElementById('svcModal')!;
  const closeBtn  = document.getElementById('svcClose')!;
  const labelEl   = document.getElementById('svcLabel')!;
  const titleEl   = document.getElementById('svcTitle')!;
  const descEl    = document.getElementById('svcDesc')!;
  const gridEl    = document.getElementById('svcProjectsGrid')!;

  function getLang(): string {
    return document.documentElement.lang || 'es';
  }

  function t(key: string): string {
    const lang = getLang();
    const dict = (window as any).__T;
    if (dict && dict[lang] && dict[lang][key]) return dict[lang][key];
    return key;
  }

  function openModal(serviceId: string) {
    const projects = SVC_PROJECTS[serviceId];
    if (!projects) return;

    const lang = getLang();
    labelEl.textContent = lang === 'en' ? 'Our Projects' : 'Nuestros Proyectos';
    titleEl.textContent = t(`svc.${serviceId}.title`);
    descEl.textContent  = t(`svc.${serviceId}.desc`);

    const photoSoon = lang === 'en' ? 'Photo coming soon' : 'Foto próximamente';
    gridEl.innerHTML = projects.map(p => `
      <div class="svc-proj-card">
        ${p.img
          ? `<img src="${p.img}" alt="${p.name}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />`
          : `<div class="svc-proj-placeholder">
               <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
               <span class="svc-proj-placeholder-text">${photoSoon}</span>
             </div>`
        }
      </div>
    `).join('');

    backdrop.classList.add('open');
    backdrop.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    backdrop.classList.remove('open');
    backdrop.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Card clicks
  document.querySelectorAll('.service-card[data-service]').forEach(card => {
    card.addEventListener('click', () => {
      openModal((card as HTMLElement).dataset.service!);
    });
    card.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        openModal((card as HTMLElement).dataset.service!);
      }
    });
  });

  // Close on button, backdrop click, and Escape
  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', (e) => {
    if (e.target === backdrop) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
