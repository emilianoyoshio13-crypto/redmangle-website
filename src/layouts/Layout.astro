---
import '../styles/global.css';
const SITE = 'https://www.redmangle.com';
const title = 'Red Mangle · Construfibra & Eventos — Fibra de Vidrio para Arquitectura de Lujo';
const description = 'Especialistas en fibra de vidrio y soluciones arquitectónicas decorativas para proyectos de lujo en México y el Caribe. Pergolados, celosías, plafones y más.';
const ogImage = `${SITE}/images/hero/slideshow/slide-1.jpeg`;
const canonical = `${SITE}${Astro.url.pathname}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'Red Mangle',
      legalName: 'Construfibra & Eventos S de RL de CV',
      url: SITE,
      logo: `${SITE}/images/logo-color.png`,
      foundingDate: '2011',
      sameAs: [],
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+52-998-850-3011',
        email: 'ventas@redmangle.com',
        contactType: 'sales',
        areaServed: 'MX',
        availableLanguage: ['Spanish', 'English']
      }
    },
    {
      '@type': ['LocalBusiness', 'GeneralContractor'],
      '@id': `${SITE}/#business`,
      name: 'Red Mangle — Construfibra & Eventos',
      image: `${SITE}/images/logo-color.png`,
      url: SITE,
      telephone: '+52-998-850-3011',
      email: 'ventas@redmangle.com',
      priceRange: '$$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Cancún',
        addressRegion: 'Quintana Roo',
        addressCountry: 'MX'
      },
      areaServed: [
        { '@type': 'Place', name: 'Riviera Maya' },
        { '@type': 'Country', name: 'México' }
      ]
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'Red Mangle',
      description,
      inLanguage: ['es-MX', 'en']
    }
  ]
};
